# CivicPress — example environment for a hosted / production instance.
# Copy to `.env` and fill in. For LOCAL DEV you generally need NONE of these:
# `civic init` generates a signing secret, and an unset NODE_ENV is treated as
# a safe (production) posture by the auth/secret gates.

# --- Security (set these for a public deploy) ---
# Root signing secret (>= 64 hex chars). Pin it so sessions survive restarts.
# `civic init` prints a freshly generated one you can paste here.
CIVICPRESS_SECRET=
# ...or point at a mounted secret file instead (Docker / Kubernetes secrets):
# CIVICPRESS_SECRET_FILE=/run/secrets/civicpress_secret

# Set to `production` on a public host. An unset value is ALSO treated as
# production by the gates (fail-safe). Use `development` only for local work.
NODE_ENV=production
# Dev-only passwordless auth. NEVER set this on a public instance.
# CIVIC_ALLOW_SIMULATED_AUTH=true

# --- Reverse proxy / networking ---
# Trust X-Forwarded-* from your reverse proxy (nginx/Caddy) so client IPs
# (rate limits) and req.secure are correct.
TRUST_PROXY=true
# Allowed browser origin(s) for the API (comma-separated). Set to the UI's
# public origin, or leave empty if the UI is served same-origin behind a proxy.
CORS_ORIGIN=
# API listen port (default 3000).
# PORT=3000

# --- UI (baked into the SPA at BUILD time; set before `pnpm build:ui`) ---
# Where the browser reaches the API. Empty = same-origin (recommended behind a
# reverse proxy); otherwise the API's public URL.
CIVIC_API_CLIENT_BASE=
# Realtime (collaborative editing / device) WebSocket, for the browser client.
# NUXT_PUBLIC_REALTIME_ENABLED=true
# NUXT_PUBLIC_REALTIME_WS_URL=wss://demo.example.org/realtime
