#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Fast and deterministic, by design. The old full-suite hook was flaky on
# parallel DB/auth races, so the standing advice became `--no-verify` — and a
# hook everyone bypasses gates nothing. Everything here is under a few seconds
# and depends on nothing but the checked-out files: no database, no network,
# no build output.
#
# What runs:
#   lint-staged     prettier/markdownlint on staged files, then ESLint on the
#                   staged JS/TS/Vue via scripts/lint-staged-eslint.mjs (each
#                   file linted by the package that owns it). Errors block the
#                   commit; the 8 known warnings do not.
#   registry:check  duplicate CLI commands / endpoints / components (~0.2s).
#
# What deliberately does NOT run, so the hook stays trustworthy:
#   tests      even a targeted slice needs a database and built dist output;
#              that is precisely the flakiness that trained the bypass. CI
#              runs the full suite on every PR and on pushes to develop/main.
#   tsc        a sound typecheck is whole-program, not per-file, and it needs
#              sibling packages BUILT — on a fresh clone or after a dependency
#              change it fails for reasons that have nothing to do with the
#              commit. Same trap: a hook that cries wolf gets bypassed.
#
# If you find yourself reaching for --no-verify, the hook has regressed into
# something too slow or too flaky. Fix the hook rather than routing around it.

# Dependencies missing → say so, in one line, and get out of the way.
#
# Without this the hook dies inside pnpm with
# `ERR_PNPM_RECURSIVE_EXEC_FIRST_FAIL Command "lint-staged" not found` and exit
# 254, which names neither the cause nor the cure. That happens on a fresh
# clone and in every new git worktree — exactly the moments someone is least
# able to tell "my commit is bad" from "my checkout is not set up", and exactly
# how a hook teaches people to reach for --no-verify.
if [ ! -x "node_modules/.bin/lint-staged" ]; then
  echo "pre-commit: dependencies are not installed — run 'pnpm install' first."
  echo "            (skip this once with 'git commit --no-verify')"
  exit 1
fi

pnpm exec lint-staged
pnpm run registry:check
